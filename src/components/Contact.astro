---
import { site } from '../data/site';
---

<section id="contact" class="contact">
  <p>{site.contact.message}</p>
  <a href={site.contact.url} class="button">{site.contact.label}</a>
</section>

<style>
  .contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding: 72px 0 96px;
    border-top: 1px solid var(--color-line);
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 24px;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-bg);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }

  .button:hover {
    color: var(--color-bg);
    opacity: 0.85;
  }
</style>

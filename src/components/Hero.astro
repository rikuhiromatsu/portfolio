---
import { site } from '../data/site';
---

<section id="top" class="hero">
  <p class="roles">
    {site.roles.map((role, i) => <>{i > 0 && <br />}{role}</>)}
  </p>
  <h1 class="headline">
    {site.headline.map((line, i) => <>{i > 0 && <br />}{line}</>)}
  </h1>
  <p class="lead">{site.lead}</p>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 120px 0 96px;
  }

  .roles {
    font-size: 13px;
    line-height: 1.8;
    color: var(--color-sub);
  }

  .headline {
    font-size: 34px;
    line-height: 1.5;
    font-weight: 700;
  }

  .lead {
    color: var(--color-sub);
  }

  @media (max-width: 480px) {
    .hero {
      padding: 72px 0 64px;
    }

    .headline {
      font-size: 24px;
    }
  }
</style>

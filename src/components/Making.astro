---
import { getCollection } from 'astro:content';
import Section from './Section.astro';

const items = (await getCollection('making')).sort((a, b) => a.data.order - b.data.order);
---

<Section id="making" label="つくっているもの">
  <ul class="grid">
    {
      items.map(({ data }) => (
        <li class="card">
          {data.image ? (
            <img src={data.image} alt="" class="thumb" loading="lazy" />
          ) : (
            <div class="thumb placeholder">[画像]</div>
          )}
          <h3>{data.url ? <a href={data.url}>{data.title}</a> : data.title}</h3>
          <p>{data.description}</p>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px 20px;
    padding: 0;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .thumb {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-placeholder);
    font-size: 12px;
    color: var(--color-sub);
  }

  h3 {
    font-size: 15px;
    font-weight: 700;
  }

  h3 a {
    text-decoration: none;
  }

  p {
    font-size: 13px;
    line-height: 1.8;
    color: var(--color-sub);
  }
</style>

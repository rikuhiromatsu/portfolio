---
import { getCollection } from 'astro:content';
import Section from './Section.astro';

const items = (await getCollection('news')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const format = (date: Date) =>
  `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, '0')}.${String(date.getDate()).padStart(2, '0')}`;
---

<Section id="news" label="お知らせ">
  <ul class="list">
    {
      items.map(({ data }) => (
        <li class="item">
          {data.url ? <a href={data.url}>{data.title}</a> : <span>{data.title}</span>}
          <time datetime={data.date.toISOString().slice(0, 10)}>{format(data.date)}</time>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 0;
    list-style: none;
  }

  .item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  time {
    font-family: var(--font-en);
    font-size: 12px;
    color: var(--color-sub);
  }
</style>
